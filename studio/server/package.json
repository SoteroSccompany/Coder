{
  "name": "coder-studio-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor do Coder Studio: arvore de arquivos, leitura/escrita segura, watcher, WebSocket e AST (recast)",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "recast": "^0.23.9",
    "ws": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "roots": [
      "<rootDir>/test"
    ]
  }
}
